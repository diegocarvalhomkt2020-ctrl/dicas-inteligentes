---
const { title, description, image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(image || '/images/og-dicas-inteligentes.png', Astro.site).toString();
const pathname = Astro.url.pathname;
const ehAtual = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><circle cx=%2216%22 cy=%2216%22 r=%223.4%22 fill=%22%23e8722c%22/><circle cx=%2216%22 cy=%225%22 r=%222.4%22 fill=%22%23e8722c%22/><circle cx=%2226.5%22 cy=%2211.5%22 r=%222.4%22 fill=%22%23e8722c%22/><circle cx=%2222.5%22 cy=%2224.5%22 r=%222.4%22 fill=%22%23e8722c%22/><circle cx=%229.5%22 cy=%2224.5%22 r=%222.4%22 fill=%22%23e8722c%22/><circle cx=%225.5%22 cy=%2211.5%22 r=%222.4%22 fill=%22%23e8722c%22/><line x1=%2216%22 y1=%2216%22 x2=%2216%22 y2=%225%22 stroke=%22%23e8722c%22 stroke-width=%221.6%22/><line x1=%2216%22 y1=%2216%22 x2=%2226.5%22 y2=%2211.5%22 stroke=%22%23e8722c%22 stroke-width=%221.6%22/><line x1=%2216%22 y1=%2216%22 x2=%2222.5%22 y2=%2224.5%22 stroke=%22%23e8722c%22 stroke-width=%221.6%22/><line x1=%2216%22 y1=%2216%22 x2=%229.5%22 y2=%2224.5%22 stroke=%22%23e8722c%22 stroke-width=%221.6%22/><line x1=%2216%22 y1=%2216%22 x2=%225.5%22 y2=%2211.5%22 stroke=%22%23e8722c%22 stroke-width=%221.6%22/></svg>" />
    <title>{title} | Dicas Inteligentes</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <!-- TODO: adicionar <meta name="google-site-verification"> quando o site for verificado no Search Console -->

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dicas Inteligentes" />
    <meta property="og:title" content={`${title} | Dicas Inteligentes`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={imagemAbsoluta} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Dicas Inteligentes`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemAbsoluta} />

    <!-- TODO: Google tag (gtag.js): colar o script real quando a propriedade GA4 for criada -->
  </head>
  <body>
    <header class="topo">
      <div class="topo-inner">
        <a href="/" class="marca">
          <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="3.4" fill="var(--cor-acento)"/>
            <circle cx="16" cy="5" r="2.4" fill="var(--cor-acento)"/>
            <circle cx="26.5" cy="11.5" r="2.4" fill="var(--cor-acento)"/>
            <circle cx="22.5" cy="24.5" r="2.4" fill="var(--cor-acento)"/>
            <circle cx="9.5" cy="24.5" r="2.4" fill="var(--cor-acento)"/>
            <circle cx="5.5" cy="11.5" r="2.4" fill="var(--cor-acento)"/>
            <line x1="16" y1="16" x2="16" y2="5" stroke="var(--cor-acento)" stroke-width="1.6"/>
            <line x1="16" y1="16" x2="26.5" y2="11.5" stroke="var(--cor-acento)" stroke-width="1.6"/>
            <line x1="16" y1="16" x2="22.5" y2="24.5" stroke="var(--cor-acento)" stroke-width="1.6"/>
            <line x1="16" y1="16" x2="9.5" y2="24.5" stroke="var(--cor-acento)" stroke-width="1.6"/>
            <line x1="16" y1="16" x2="5.5" y2="11.5" stroke="var(--cor-acento)" stroke-width="1.6"/>
          </svg>
          Dicas Inteligentes
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir menu">
          <span class="menu-toggle-icon"></span>
        </button>
        <nav id="menu-principal">
          <a href="/" aria-current={ehAtual('/') ? 'page' : undefined}>Início</a>
          <a href="/sobre/" aria-current={ehAtual('/sobre/') ? 'page' : undefined}>Sobre</a>
        </nav>
      </div>
    </header>
    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const menuPrincipal = document.querySelector('#menu-principal');
      if (menuToggle && menuPrincipal) {
        menuToggle.addEventListener('click', () => {
          const aberto = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!aberto));
          menuPrincipal.classList.toggle('aberto');
        });
      }
    </script>
    <main>
      <slot />
    </main>
    <footer class="rodape">
      <p class="rodape-marca">Dicas Inteligentes</p>
      <p>Conteúdo real, testado e sem enrolação. Sempre com o defeito honesto de cada produto, não só a nota 5 estrelas.</p>
      <p class="rodape-links"><a href="/sobre/">Sobre</a> · <a href="mailto:contato@dicasinteligentes.com">contato@dicasinteligentes.com</a> · <a href="/privacidade/">Política de Privacidade</a></p>
      <p class="rodape-copy">© {new Date().getFullYear()} Dicas Inteligentes</p>
    </footer>
    <style is:global>
      :root {
        --cor-texto: #262521;
        --cor-texto-suave: #6b6a63;
        --cor-fundo: #fdf3e7;
        --cor-superficie: #ffffff;
        --cor-borda: #ecdfcc;
        --cor-acento: #e8722c;
        --cor-escuro: #1c2128;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, "Segoe UI", Arial, sans-serif;
        color: var(--cor-texto);
        background: var(--cor-fundo);
        line-height: 1.6;
      }
      h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 700; }
      a { color: var(--cor-acento); }
      a:hover { text-decoration-thickness: 2px; }
      .topo {
        position: sticky;
        top: 0;
        z-index: 10;
        padding: 0 1.5rem;
        border-bottom: 1px solid var(--cor-borda);
        background: var(--cor-superficie);
        box-shadow: 0 1px 4px rgba(0,0,0,0.045);
      }
      .topo-inner {
        max-width: 920px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.9rem 0;
      }
      .marca {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--cor-acento);
        font-family: Georgia, serif;
        flex-shrink: 0;
        white-space: nowrap;
      }
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
      }
      .menu-toggle-icon,
      .menu-toggle-icon::before,
      .menu-toggle-icon::after {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--cor-texto);
        border-radius: 2px;
      }
      .menu-toggle-icon { position: relative; }
      .menu-toggle-icon::before,
      .menu-toggle-icon::after {
        content: '';
        position: absolute;
        left: 0;
      }
      .menu-toggle-icon::before { top: -7px; }
      .menu-toggle-icon::after { top: 7px; }
      .topo nav a {
        color: var(--cor-texto-suave);
        font-weight: 600;
        text-decoration: none;
        padding: 0.5rem 0.75rem;
        margin-left: 0.25rem;
        border-radius: 6px;
      }
      .topo nav a:hover { color: var(--cor-acento); background: var(--cor-fundo); }
      .topo nav a[aria-current="page"] { color: var(--cor-acento); background: var(--cor-fundo); text-decoration: underline; }
      .topo nav { display: flex; flex-wrap: wrap; align-items: center; }
      @media (max-width: 820px) {
        .menu-toggle { display: block; }
        .topo-inner { flex-wrap: wrap; }
        .topo nav {
          display: none;
          flex-direction: column;
          align-items: stretch;
          width: 100%;
          padding: 0.5rem 0 0.9rem;
        }
        .topo nav.aberto { display: flex; }
        .topo nav a { margin-left: 0; margin-top: 0.25rem; }
      }
      main { max-width: 880px; margin: 0 auto; padding: 0 1.5rem; }
      .rodape {
        margin: 3rem 0 0;
        padding: 2rem 1.5rem;
        border-top: 1px solid var(--cor-borda);
        color: var(--cor-texto-suave);
        font-size: 0.85rem;
        text-align: center;
      }
      .rodape-marca { font-family: Georgia, serif; font-weight: 700; color: var(--cor-texto); margin: 0 0 0.4rem; font-size: 1rem; }
      .rodape-links { margin: 0.75rem 0 0.5rem; }
      .rodape-copy { margin: 0.5rem 0 0; font-size: 0.78rem; }
    </style>
  </body>
</html>
