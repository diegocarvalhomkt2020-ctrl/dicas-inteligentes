---
import Layout from '../layouts/Layout.astro';
import blog from '../data/blog.json';
import rede from '../data/rede-numeros.json';

// Posts com dado próprio da pesquisa, em destaque na home pra ajudar o Google a descobrir o blog.
const slugsDestaque = [
  'preco-caro-nao-e-sinal-de-qualidade-o-que-aprendemos',
  'mesma-faixa-de-preco-qualidade-diferente',
  'bateria-wifi-motor-os-pontos-de-falha-que-se-repetem',
  'produto-com-poucas-avaliacoes-vale-a-pena-arriscar',
];
const destaques = slugsDestaque
  .map((s) => blog.posts.find((p) => p.slug === s))
  .filter(Boolean);


// Números contados nos dados publicados dos sites (scripts/gerar-numeros-rede.py).
const fmt = (n) => n.toLocaleString('pt-BR');
const reais = (n) => `R$ ${fmt(n)}`;
const nota = (n) => n.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 2 });
const milhares = Math.round(rede.avaliacoes / 1000);
const dataNumeros = rede.geradoEm.split('-').reverse().join('/');
const pctAlta = Math.round((rede.de45ouMais / rede.produtos) * 100);

const site = "https://dicasinteligentes.com";

const sites = [
  {
    nome: "Casa Prática",
    url: "https://casapratica.dicasinteligentes.com",
    descricao: "Organização de casa por zona, sem gastar à toa.",
    cor: "#0f6e56",
    corFundo: "#eef7f3",
    icone: '<path d="M3 11l9-7 9 7"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/>',
  },
  {
    nome: "Amigo Pet",
    url: "https://amigopet.dicasinteligentes.com",
    descricao: "Comparativos honestos de produto pra gato e cachorro.",
    cor: "#c8632c",
    corFundo: "#fdf0e6",
    icone: '<circle cx="12" cy="8" r="3"/><path d="M7 21v-2a5 5 0 0 1 10 0v2"/>',
  },
  {
    nome: "Bela Receita",
    url: "https://belareceita.dicasinteligentes.com",
    descricao: "Receitas fáceis, do dia a dia à ocasião especial.",
    cor: "#a12a2a",
    corFundo: "#faeaea",
    icone: '<path d="M11 3v6M8 3v6M14 3v6M8 9c0 2 1 3 3 3s3-1 3-3M11 12v9"/>',
  },
  {
    nome: "Café Ideal",
    url: "https://cafe.dicasinteligentes.com",
    descricao: "Cafeteira, moedor e mais, pra escolher sem chute.",
    cor: "#6f4423",
    corFundo: "#f3ebe1",
    icone: '<path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/>',
  },
  {
    nome: "Mundo Bebê",
    url: "https://mundobebe.dicasinteligentes.com",
    descricao: "Produto de bebê é decisão de segurança, sempre com o defeito real declarado.",
    cor: "#4f7d8c",
    corFundo: "#ecf3f4",
    icone: '<path d="M8 2v4M16 2v4"/><rect x="4" y="8" width="16" height="13" rx="3"/><path d="M9 13a3 3 0 0 0 6 0"/>',
  },
  {
    nome: "E-books",
    url: "/ebooks/",
    descricao: "Guias em PDF prontos pra usar, direto no celular.",
    cor: "#8a5a9e",
    corFundo: "#f2ecf5",
    icone: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  },
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Dicas Inteligentes",
  url: `${site}/`,
  inLanguage: "pt-BR",
  description: "Rede de sites de comparativos honestos de produto, sempre com preço em faixa e o defeito real de cada um.",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Dicas Inteligentes",
  url: `${site}/`,
  description: "Rede de sites de comparativos e listas de produto: organização de casa, pet, receitas, café e bebê.",
};
---
<Layout
  title="Comparativos honestos, sem enrolação"
  description="A rede Dicas Inteligentes pesquisa produto de verdade e nunca esconde o defeito. Preço sempre em faixa, nota sempre real. Escolha seu assunto."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <section class="hero">
    <p class="eyebrow">Dicas Inteligentes</p>
    <h1>Comparativo <span class="destaque">honesto</span> de produto, sem enrolação.</h1>
    <p class="hero-texto">
      Preço sempre em faixa, nunca fixo. Nota só quando é avaliação real.
      E todo produto vem com o defeito que ninguém conta, pesquisado
      direto nas avaliações de quem já comprou.
    </p>
  </section>

  <section class="sites">
    <h2>Por onde você quer começar?</h2>
    <div class="sites-grade">
      {sites.map((s) => (
        <a class="site-card" href={s.url} rel={s.url.startsWith('http') ? 'noopener' : undefined} style={`--cor-card:${s.cor}; --cor-card-bg:${s.corFundo}`}>
          <div class="icone" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${s.icone}</svg>`} />
          <strong>{s.nome}</strong>
          <span>{s.descricao}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="numeros">
    <h2>A rede em números</h2>
    <p class="numeros-intro">
      Contados nos dados publicados nos nossos sites. Atualizado em {dataNumeros}.
    </p>
    <ul class="numeros-destaques">
      <li><strong>{rede.produtos}</strong><span>produtos pesquisados nos 4 sites de comparativo</span></li>
      <li><strong>{rede.comDefeitoDeclarado} de {rede.produtos}</strong><span>com o defeito real declarado</span></li>
      <li><strong>{milhares} mil</strong><span>avaliações de compradores somadas por trás das notas</span></li>
      <li><strong>{rede.receitas}</strong><span>receitas passo a passo no Bela Receita</span></li>
    </ul>
    <div class="numeros-sites">
      {rede.sites.map((s) => (
        <a class="numeros-site" href={s.url} rel="noopener">
          <strong>{s.nome}</strong>
          <dl>
            <div><dt>Produtos</dt><dd>{s.produtos}</dd></div>
            <div><dt>Faixa de preço</dt><dd class="sem-quebra">{reais(s.precoMenor)} a {reais(s.precoMaior)}</dd></div>
            <div><dt>Nota média</dt><dd>{nota(s.notaMedia)}</dd></div>
            <div><dt>Menor nota</dt><dd>{nota(s.notaMenor)}</dd></div>
          </dl>
        </a>
      ))}
    </div>
    <p class="numeros-leitura">
      A nota média da rede é {nota(rede.notaMedia)}, e {pctAlta}% dos produtos têm 4,5 ou mais. Só {rede.abaixoDe4} ficam abaixo de 4.
      Quando quase tudo tem nota alta, a nota sozinha não separa o bom do ruim.
      Por isso cada produto mostra o defeito que os compradores mais citam.
    </p>
  </section>

  <section class="blog-destaque">
    <h2>No blog: o que aprendemos pesquisando</h2>
    <div class="blog-grade">
      {destaques.map((p) => (
        <a class="blog-card" href={`/blog/${p.slug}/`}>
          <strong>{p.titulo}</strong>
          <span>{p.resumo}</span>
        </a>
      ))}
    </div>
    <p class="blog-todos"><a href="/blog/">Ver todos os posts do blog →</a></p>
  </section>

  <section class="metodo">
    <h2>Como trabalhamos</h2>
    <p>
      Não temos os produtos em mãos, e é melhor dizer isso logo. O que
      fazemos é ler, produto por produto, as avaliações de quem comprou e
      mostrar o que se repete, principalmente o defeito. Por isso nenhum
      produto entra numa lista sem um problema real citado por compradores,
      e nenhum defeito é inventado.
    </p>
    <p>
      Preço é sempre faixa, porque muda toda hora. Nota só aparece quando
      existe avaliação suficiente por trás dela. E não é sobre indicar o
      mais caro: é sobre mostrar o que vale saber antes de comprar.
    </p>
    <p class="metodo-link"><a href="/metodo/">Veja o passo a passo completo da pesquisa →</a></p>
  </section>

  <style>
    .hero { padding: 3rem 0 2.5rem; text-align: center; }
    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      color: var(--cor-acento);
      font-weight: 800;
      margin: 0 0 0.9rem;
    }
    .hero h1 {
      font-family: -apple-system, "Segoe UI", Arial, sans-serif;
      font-weight: 800;
      letter-spacing: -0.02em;
      font-size: 2.4rem;
      line-height: 1.18;
      margin: 0 0 1.1rem;
    }
    .hero h1 .destaque { color: var(--cor-acento); }
    .hero-texto {
      max-width: 560px;
      margin: 0 auto;
      color: var(--cor-texto-suave);
      font-size: 1.05rem;
    }
    .sites { margin: 2rem 0; }
    .sites h2 { font-size: 1.25rem; margin: 0 0 1.25rem; text-align: center; }
    .sites-grade {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .site-card {
      display: block;
      border: 1px solid var(--cor-borda);
      border-top: 4px solid var(--cor-card);
      border-radius: 16px;
      padding: 1.25rem 1.4rem;
      text-decoration: none;
      color: var(--cor-texto);
      background: var(--cor-card-bg);
    }
    .site-card .icone {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--cor-card);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.85rem;
    }
    .site-card strong {
      display: block;
      margin-bottom: 0.4rem;
      color: var(--cor-card);
      font-family: Georgia, serif;
      font-size: 1.1rem;
    }
    .site-card span { font-size: 0.9rem; color: var(--cor-texto-suave); }
    .numeros { margin: 3rem 0 0; }
    .numeros h2 { font-size: 1.25rem; margin: 0 0 0.5rem; text-align: center; }
    .numeros-intro { text-align: center; color: var(--cor-texto-suave); font-size: 0.9rem; margin: 0 0 1.5rem; }
    .numeros-destaques {
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }
    .numeros-destaques li {
      border: 1px solid var(--cor-borda);
      border-radius: 14px;
      padding: 1rem 1.1rem;
      text-align: center;
    }
    .numeros-destaques strong {
      display: block;
      font-family: Georgia, serif;
      font-size: 1.7rem;
      color: var(--cor-acento);
      line-height: 1.15;
      margin-bottom: 0.35rem;
    }
    .numeros-destaques span { font-size: 0.85rem; color: var(--cor-texto-suave); }
    .numeros-sites {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .numeros-site {
      display: block;
      border: 1px solid var(--cor-borda);
      border-radius: 14px;
      padding: 1rem 1.2rem;
      text-decoration: none;
      color: var(--cor-texto);
    }
    .numeros-site strong { display: block; font-family: Georgia, serif; margin-bottom: 0.6rem; }
    .numeros-site dl { margin: 0; }
    .numeros-site dl div { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.2rem 0; font-size: 0.88rem; }
    .numeros-site dt { color: var(--cor-texto-suave); }
    .numeros-site dd { margin: 0; font-weight: 700; text-align: right; }
    .sem-quebra { white-space: nowrap; }
    .numeros-leitura { max-width: 640px; margin: 1.5rem auto 0; text-align: center; color: var(--cor-texto-suave); font-size: 0.95rem; }
    .blog-destaque { margin: 2.5rem 0 0; }
    .blog-destaque h2 { font-size: 1.25rem; margin: 0 0 1.25rem; text-align: center; }
    .blog-grade {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
    .blog-card {
      display: block;
      border: 1px solid var(--cor-borda);
      border-radius: 14px;
      padding: 1.1rem 1.25rem;
      text-decoration: none;
      color: var(--cor-texto);
    }
    .blog-card strong { display: block; margin-bottom: 0.4rem; font-size: 1rem; }
    .blog-card span { font-size: 0.88rem; color: var(--cor-texto-suave); }
    .blog-todos { text-align: center; margin: 1.1rem 0 0; font-weight: 600; }
    .metodo {
      margin: 3rem 0 2rem;
      padding: 1.75rem;
      background: var(--cor-escuro);
      color: #f2f0ea;
      border-radius: 14px;
    }
    .metodo h2 { margin: 0 0 0.75rem; color: #fff; font-size: 1.2rem; }
    .metodo p { margin: 0 0 0.75rem; color: #d8d5cb; font-size: 0.95rem; }
    .metodo-link { margin-top: 0.9rem !important; }
    .metodo-link a { color: #fff; font-weight: 600; }
  </style>
</Layout>
