---
import Layout from '../../layouts/Layout.astro';

const ebooks = [
  {
    titulo: "Air Fryer Sem Segredo",
    subtitulo: "30 receitas fáceis",
    descricao: "Receitas com ingrediente fácil de achar e passo a passo curto, pra abrir no celular e cozinhar na hora.",
    preco: "R$ 27,00",
    marca: "Bela Receita",
    url: "https://ebook.dicasinteligentes.com",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "E-books", item: "https://dicasinteligentes.com/ebooks/" },
  ],
};
---
<Layout
  title="E-books"
  description="Guias em PDF da rede Dicas Inteligentes, com passo a passo direto, pagamento único e acesso imediato, prontos pra usar no celular."
>
  <p><a href="/">← Início</a></p>
  <h1>E-books</h1>
  <p class="intro">
    Guias em PDF das nossas marcas, com passo a passo direto e sem
    enrolação. Pagamento único, acesso imediato.
  </p>

  <div class="lista">
    {ebooks.map((e) => (
      <a class="card" href={e.url} rel="noopener">
        <p class="marca-tag">{e.marca}</p>
        <strong>{e.titulo}</strong>
        <span class="subtitulo">{e.subtitulo}</span>
        <p class="descricao">{e.descricao}</p>
        <p class="preco">{e.preco}</p>
      </a>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .intro { color: var(--cor-texto-suave); max-width: 560px; margin: 1rem 0 2rem; }
    .lista { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-bottom: 2rem; }
    .card {
      display: block;
      border: 1px solid var(--cor-borda);
      border-radius: 16px;
      padding: 1.4rem 1.5rem;
      text-decoration: none;
      color: var(--cor-texto);
      background: var(--cor-superficie);
    }
    .marca-tag {
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--cor-acento);
      margin: 0 0 0.4rem;
    }
    .card strong { display: block; font-family: Georgia, serif; font-size: 1.2rem; margin-bottom: 0.2rem; }
    .subtitulo { display: block; font-size: 0.85rem; color: var(--cor-texto-suave); margin-bottom: 0.6rem; }
    .descricao { margin: 0 0 0.9rem; font-size: 0.92rem; color: var(--cor-texto-suave); }
    .preco { font-weight: 700; font-size: 1.05rem; margin: 0; }
  </style>
</Layout>
