---
import Layout from '../../layouts/Layout.astro';
import dados from '../../data/blog.json';

export function getStaticPaths() {
  return dados.posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post: p } = Astro.props;
const corCategoria = p.categoria === 'Educação de consumo' ? '#3a6ea5' : '#e8722c';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://dicasinteligentes.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://dicasinteligentes.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": p.titulo, "item": `https://dicasinteligentes.com/blog/${p.slug}/` },
  ],
};

const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": p.titulo,
  "description": p.resumo,
  "datePublished": p.dataPublicacao,
  "author": { "@type": "Organization", "name": "Dicas Inteligentes" },
};

const faqSchema = p.faq && p.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": p.faq.map((f) => ({
    "@type": "Question",
    "name": f.pergunta,
    "acceptedAnswer": { "@type": "Answer", "text": f.resposta },
  })),
} : null;
---
<Layout title={p.titulo} description={p.resumo}>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <nav class="trilha">
    <a href="/">Início</a> &rsaquo; <a href="/blog/">Blog</a> &rsaquo; {p.titulo}
  </nav>

  <span class="categoria" style={`color:${corCategoria}`}>{p.categoria}</span>
  <h1>{p.titulo}</h1>
  <p class="atualizado">Publicado em {new Date(p.dataPublicacao + 'T00:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}</p>

  <div class="corpo">
    {p.corpo.map((bloco) => {
      if (bloco.tipo === 'paragrafo') return <p>{bloco.texto}</p>;
      if (bloco.tipo === 'subtitulo') return <h2>{bloco.texto}</h2>;
      if (bloco.tipo === 'lista') return (
        <ul>
          {bloco.itens.map((item) => <li>{item}</li>)}
        </ul>
      );
      return null;
    })}
  </div>

  {p.sitesRelacionados && p.sitesRelacionados.length > 0 && (
    <section class="relacionados">
      <h2>Onde ver isso na prática</h2>
      <div class="relacionados-grade">
        {p.sitesRelacionados.map((s) => (
          <a class="relacionado-card" href={s.url} style={`--cor-card:${s.cor}`}>
            <strong>{s.nome}</strong>
            <span>{s.descricao}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {p.faq && p.faq.length > 0 && (
    <section class="faq">
      <h2>Perguntas frequentes</h2>
      {p.faq.map((item) => (
        <div class="faq-item">
          <h3>{item.pergunta}</h3>
          <p>{item.resposta}</p>
        </div>
      ))}
    </section>
  )}

  <p class="cta-final"><a href="/blog/">← Ver todos os posts do blog</a></p>

  <style>
    .trilha { font-size: 0.85rem; color: var(--cor-texto-suave); margin-bottom: 1rem; }
    .trilha a { color: var(--cor-texto-suave); }
    .categoria {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--cor-acento);
      margin-bottom: 0.5rem;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; margin-top: -0.5rem; }
    .corpo p { margin: 0 0 1.1rem; }
    .corpo h2 { margin: 1.75rem 0 0.75rem; font-size: 1.25rem; font-family: Georgia, serif; }
    .corpo ul { padding-left: 1.2rem; margin: 0 0 1.1rem; }
    .corpo li { margin-bottom: 0.4rem; }
    .relacionados {
      margin: 2.5rem 0;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .relacionados h2 { margin: 0 0 1rem; font-size: 1.1rem; font-family: Georgia, serif; }
    .relacionados-grade {
      display: grid;
      gap: 0.9rem;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .relacionado-card {
      display: block;
      border: 1px solid var(--cor-borda);
      border-top: 3px solid var(--cor-card);
      border-radius: 10px;
      padding: 0.9rem 1rem;
      text-decoration: none;
      color: var(--cor-texto);
      background: var(--cor-superficie);
    }
    .relacionado-card strong { display: block; margin-bottom: 0.3rem; color: var(--cor-card); }
    .relacionado-card span { font-size: 0.85rem; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq h2 { font-family: Georgia, serif; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }
    .cta-final {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
